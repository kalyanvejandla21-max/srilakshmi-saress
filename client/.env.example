# Sri Lakshmi Sarees - Client Environment Variables
# Copy to .env.local for local overrides or configure in Vercel Project Settings

# Render Backend API URL (leave blank in local dev to use Vite proxy, or set to your Render deployment URL)
# Example: https://sri-lakshmi-sarees-api.onrender.com
VITE_API_BASE_URL=

# Cashfree Payments:
# No client keys required! CASHFREE_APP_ID and CASHFREE_SECRET_KEY are strictly server-side.
# The server dynamically issues single-use paymentSessionId at checkout.
# NEVER put CASHFREE_SECRET_KEY or backend credentials in client environment or code.

# Razorpay Public Key ID (optional fallback test/production public key for checkout modal)
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key
