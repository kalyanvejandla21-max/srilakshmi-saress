# Sri Lakshmi Sarees - Server Environment Variables Configuration
# Copy this file to .env for local development

PORT=5000
NODE_ENV=development

# Frontend Origins allowed for CORS (comma-separated or single domain)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CLIENT_URL=http://localhost:3000

# Administrator Credentials & JWT Authentication
# In production on Render, set a strong custom password and secret in Environment Variables
ADMIN_EMAIL=admin@srilakshmisarees.com
ADMIN_PASSWORD=admin@SLS2026!
JWT_SECRET=sls_jwt_secure_secret_prod_key_2026

# Optional MongoDB Connection String (MongoDB Atlas)
# In production on Render, set this in the Render Dashboard Environment tab
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/srilakshmi?retryWrites=true&w=majority

# Cashfree Payments Gateway Configuration (Primary Online Payment Gateway)
# Read strictly on server-side. NEVER commit or expose CASHFREE_SECRET_KEY to frontend, git, or client logs.
# Obtain your App ID & Secret Key from the Cashfree Merchant Dashboard: https://merchant.cashfree.com/
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# CASHFREE_ENV: TEST (sandbox) for development/testing, or PRODUCTION for live transactions
CASHFREE_ENV=TEST
# CASHFREE_API_VERSION: Cashfree API version (defaults to 2023-08-01)
CASHFREE_API_VERSION=2023-08-01

# Razorpay Test / Production Keys (Secondary / Legacy Online Payments)
# Maintained for fallback & transitional compatibility:
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Shiprocket Courier Integration (Optional for live automated AWB generation)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Order Notification Email Delivery Configuration
# Default business recipient is bhavanivejandla6@gmail.com
NOTIFICATION_EMAIL=bhavanivejandla6@gmail.com

# --- OPTION 1: Resend HTTPS API (STRONGLY RECOMMENDED for Render cloud deployments) ---
# Cloud platforms like Render block raw SMTP ports (587/465). Resend sends over standard HTTPS (Port 443).
# Get a free API key at https://resend.com (free 3,000 emails/mo, no credit card required)
# IMPORTANT RESEND RULES:
# 1. Do NOT set EMAIL_FROM to @gmail.com or any public domain (Resend strictly rejects unverified public domains).
# 2. For testing without a custom domain, use: EMAIL_FROM="Sri Lakshmi Sarees" <onboarding@resend.dev>
#    Note: With onboarding@resend.dev, Resend ONLY delivers to the email address you registered your Resend account with.
# 3. For production delivery to business/customer inboxes, verify your domain in Resend and set:
#    EMAIL_FROM="Sri Lakshmi Sarees" <orders@yourdomain.com>
RESEND_API_KEY=
EMAIL_FROM="Sri Lakshmi Sarees" <onboarding@resend.dev>

# --- OPTION 2: Brevo HTTPS API (Alternative HTTPS provider) ---
# Get free API key at https://brevo.com (free 300 emails/day)
# In Brevo, individual senders can be verified via a 6-digit code sent to that email.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# --- OPTION 3: Direct SMTP / Gmail App Password (Local Development Only) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
