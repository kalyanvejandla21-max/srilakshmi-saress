# Sri Lakshmi Sarees - Server Environment Variables Configuration
# Copy this file to .env for local development

PORT=5000
NODE_ENV=development

# Frontend Origins allowed for CORS (comma-separated or single domain)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CLIENT_URL=http://localhost:3000

# Administrator Credentials & JWT Authentication
# In production on Render, set a strong custom password and secret in Environment Variables
ADMIN_EMAIL=admin@srilakshmisarees.com
ADMIN_PASSWORD=admin@SLS2026!
JWT_SECRET=sls_jwt_secure_secret_prod_key_2026

# Optional MongoDB Connection String (MongoDB Atlas)
# In production on Render, set this in the Render Dashboard Environment tab
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/srilakshmi?retryWrites=true&w=majority

# Razorpay Test / Production Keys (Optional for online payments)
# When ready for live payments, populate your verified Razorpay merchant keys:
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Shiprocket Courier Integration (Optional for live automated AWB generation)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Order Notification Email Delivery Configuration (SMTP / Gmail App Password)
# Default business recipient is bhavanivejandla6@gmail.com
NOTIFICATION_EMAIL=bhavanivejandla6@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Sri Lakshmi Sarees" <no-reply@srilakshmisarees.com>
