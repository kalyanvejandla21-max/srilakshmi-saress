# ===================================================
# Sri Lakshmi Sarees - Master Environment Configuration
# ===================================================

# -----------------
# Render Backend Environment Variables (Configured in Render Dashboard)
# -----------------
PORT=10000
NODE_ENV=production

# Allowed Origins for CORS (Set to your Vercel deployment URL or comma-separated list)
# Example: https://sri-lakshmi-sarees.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=https://srilakshmi-saress.vercel.app,http://localhost:3000

# Client URL (Main frontend production domain)
CLIENT_URL=https://srilakshmi-saress.vercel.app

# Administrator Credentials & Authentication
ADMIN_EMAIL=admin@srilakshmisarees.com
ADMIN_PASSWORD=change_this_to_strong_admin_password_in_render
JWT_SECRET=generate_a_64_character_random_hex_string_for_production

# Production Database (MongoDB Atlas Cluster Connection String)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/srilakshmi?retryWrites=true&w=majority
MONGODB_URI=

# Payment Gateway Secrets (Server-side only - NEVER expose on frontend)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Shiprocket Courier API (Optional)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Order Notification Email Delivery
NOTIFICATION_EMAIL=bhavanivejandla6@gmail.com

# --- OPTION 1: Resend HTTPS API (STRONGLY RECOMMENDED for Render cloud deployments) ---
# Cloud platforms like Render block raw SMTP ports (587/465). Resend sends over standard HTTPS (Port 443).
# Get a free API key at https://resend.com (free 3,000 emails/mo, no credit card required)
RESEND_API_KEY=
EMAIL_FROM="Sri Lakshmi Sarees" <onboarding@resend.dev>

# --- OPTION 2: Brevo HTTPS API (Alternative HTTPS provider) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# --- OPTION 3: Direct SMTP / Gmail App Password (Local Development Only) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# -----------------
# Vercel Frontend Environment Variables (Configured in Vercel Project Settings)
# -----------------
# Set to your deployed Render backend web service URL
VITE_API_BASE_URL=https://srilakshmi-saress.onrender.com

# Razorpay Public Key ID (Client-side - Safe for public browser)
VITE_RAZORPAY_KEY_ID=
