# ===================================================
# Sri Lakshmi Sarees - Master Environment Configuration
# ===================================================

# -----------------
# Render Backend Environment Variables (Configured in Render Dashboard)
# -----------------
PORT=10000
NODE_ENV=production

# Allowed Origins for CORS (Set to your Vercel deployment URL or comma-separated list)
# Example: https://sri-lakshmi-sarees.vercel.app
ALLOWED_ORIGINS=https://sri-lakshmi-sarees.vercel.app,http://localhost:3000

# Client URL
CLIENT_URL=https://sri-lakshmi-sarees.vercel.app

# Production Database (Optional MongoDB Atlas Cluster Connection String)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/srilakshmi?retryWrites=true&w=majority

# Payment Gateway Secrets (Server-side only - NEVER expose on frontend)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=test_razorpay_secret_key

# -----------------
# Vercel Frontend Environment Variables (Configured in Vercel Project Settings)
# -----------------
# Set to your deployed Render backend web service URL
# Example: https://sri-lakshmi-sarees-api.onrender.com
VITE_API_BASE_URL=https://sri-lakshmi-sarees-api.onrender.com

# Razorpay Public Key ID (Client-side)
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key
